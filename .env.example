# DMS 环境变量模板（.env.example）
# 用法：复制为 .env 后填入真实值。本文件不含任何真实密钥，可安全提交 Git。
# 生成日期：2026-10-10

# 数据库配置
# 支持敏感信息加密存储（使用 encrypt() 函数加密后填入）

# 加密密钥（生产环境请更换）
ENCRYPTION_KEY=<YOUR_ENCRYPTION_KEY>

# 数据库类型：TiDB（云端）或 local（本地数据库）
DB_ACTIVE=TiDB

# ============ 本地 MySQL 数据库配置 ============
DB_LOCAL_HOST=127.0.0.1
DB_LOCAL_PORT=3306
DB_LOCAL_USER=root
DB_LOCAL_PASSWORD=<YOUR_DB_LOCAL_PASSWORD>
DB_LOCAL_DATABASE=DMS

# ============ TiDB Cloud 数据库配置 ============
DB_TIDB_HOST=<YOUR_TIDB_HOST>
DB_TIDB_PORT=4000
DB_TIDB_USER=<YOUR_DB_TIDB_USER>
DB_TIDB_PASSWORD=<YOUR_DB_TIDB_PASSWORD>
DB_TIDB_DATABASE=DMS

# ============ Cloudflare 配置 ============

# DMS Deploy API Token（部署 Pages + Worker）
CLOUDFLARE_API_TOKEN=<YOUR_CLOUDFLARE_API_TOKEN>

# Cloudflare Account ID（Wrangler 部署必需）
CLOUDFLARE_ACCOUNT_ID=<YOUR_CLOUDFLARE_ACCOUNT_ID>

# Cloudflare 账号邮箱
CF_EMAIL=<YOUR_CF_EMAIL>

# Cloudflare Global API Key（同步脚本用）
CF_API_KEY=<YOUR_CF_API_KEY>

# DMS D1 Sync API Token
DMS_D1_Sync_API=<YOUR_DMS_D1_Sync_API>

# ============ S3 对象存储配置（图片/附件） ============
# 切换方式：修改 S3_ACTIVE = 'hi168' 或 'cstcloud'
S3_ACTIVE=cstcloud

# ---------- hi168（测试）----------
S3_hi168_ENDPOINT=https://s3.hi168.com
S3_hi168_REGION=us-east-1
S3_hi168_BUCKET=hi168-u314763-pto14gg8-s
S3_hi168_PUBLIC_URL=https://s3.hi168.com/hi168-u314763-pto14gg8-s
S3_hi168_ACCESS_KEY=<YOUR_S3_hi168_ACCESS_KEY>
S3_hi168_SECRET_KEY=<YOUR_S3_hi168_SECRET_KEY>

# ---------- cstcloud（正式）----------
CSTCLOUD_S3_ENDPOINT=https://s3.cstcloud.cn
CSTCLOUD_S3_REGION=us-east-1
CSTCLOUD_S3_BUCKET=4e76329535754d69938766237acfe5f3
CSTCLOUD_S3_PUBLIC_URL=https://s3.cstcloud.cn/4e76329535754d69938766237acfe5f3
CSTCLOUD_S3_ACCESS_KEY=<YOUR_CSTCLOUD_S3_ACCESS_KEY>
CSTCLOUD_S3_SECRET_KEY=<YOUR_CSTCLOUD_S3_SECRET_KEY>
PORT=3001
